{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https: http:; style-src 'self' 'unsafe-inline' https: http:; font-src 'self' https: http: data:; img-src 'self' data: blob: https: http:; connect-src 'self' data: blob: https: http: wss:; frame-src 'self' data: blob: https: http:; frame-ancestors 'self' https://*.google.com https://*.run.app; object-src 'none'; base-uri 'self'; upgrade-insecure-requests;"
        }
      ]
    },
    {
      "source": "/api/efhub-proxy",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/efhub-proxy",
      "destination": "/api/efhub-proxy"
    },
    {
      "source": "/api/efhub-player",
      "destination": "/api/efhub-player"
    },
    {
      "source": "/efootball/:path*",
      "destination": "/api/efhub-proxy?url=https://pesdb.net/efootball/:path*"
    },
    {
      "source": "/efootball",
      "destination": "/api/efhub-proxy?url=https://pesdb.net/efootball/"
    },
    {
      "source": "/assets/:path*",
      "destination": "/api/efhub-proxy?url=https://pesdb.net/assets/:path*"
    },
    {
      "source": "/players/:path*",
      "destination": "/api/efhub-proxy?url=https://efhub.com/players/:path*"
    },
    {
      "source": "/players",
      "destination": "/api/efhub-proxy?url=https://efhub.com/players"
    },
    {
      "source": "/_next/:path*",
      "destination": "/api/efhub-proxy?url=https://efhub.com/_next/:path*"
    },
    {
      "source": "/articles/:path*",
      "destination": "/api/efhub-proxy?url=https://efhub.com/articles/:path*"
    },
    {
      "source": "/api/feedback",
      "destination": "/api/feedback"
    },
    {
      "source": "/api/payment/:action*",
      "destination": "/api/payment?action=:action*"
    },
    {
      "source": "/api/user/:action*",
      "destination": "/api/user?action=:action*"
    },
    {
      "source": "/api/auth/:action*",
      "destination": "/api/auth?action=:action*"
    },
    {
      "source": "/api/send-email-otp",
      "destination": "/api/auth?action=send-email-otp"
    }
  ]
}
