# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CUSTOM_DOMAIN: Custom domain configuration for production (eFootballAIHub.com)
CUSTOM_DOMAIN="eFootballAIHub.com"

# Optional WhatsApp Gateway Integration (For automatic WhatsApp SMS/Cloud API dispatch)
# If left blank, the app uses direct 1-click WhatsApp messaging and standalone OTP verification
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Website Email Dispatch (Sends 6-digit verification emails to users from info@efootballaihub.com)
# SENDER ADDRESS: Default is "eFootball AI Hub <info@efootballaihub.com>"
EMAIL_FROM="eFootball AI Hub <info@efootballaihub.com>"

# Option A: Brevo / Sendinblue API (Free 300 emails/day - recommended for transactional verification)
BREVO_API_KEY=

# Option B: Resend API (Alternative REST API)
RESEND_API_KEY=

# Option C: Gmail App Password
GMAIL_USER=
GMAIL_APP_PASS=

# Option D: SMTP Server (Hostinger, cPanel webmail, Google Workspace, AWS SES, Zoho)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=info@efootballaihub.com
SMTP_PASS=

# Payment Architecture Configuration (Pesapal Exclusive Gateway)
PAYMENT_TEST_MODE=false
PAID_ANALYSIS_PRICE_USD=2.00

# Pesapal Gateway (East Africa & Global - M-Pesa, Airtel Money, Visa, Mastercard)
PESAPAL_CONSUMER_KEY=TH507JLWbPOMGhF4b/gsm7XmX11MxcjQ
PESAPAL_CONSUMER_SECRET=zsjjV2+8++YrS5tm5uqmuiUMx2g=
PESAPAL_IPN_ID=
PESAPAL_ENVIRONMENT=production
PESAPAL_IPN_URL=

