rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile and authentication accounts - accessible for cross-device synchronization
    match /users/{userId} {
      allow read, write: if true;
    }

    match /authAccounts/{accountId} {
      allow read, write: if true;
    }

    // Saved Analyses
    match /savedAnalyses/{analysisId} {
      allow read, write: if true;
    }

    // User Squads
    match /userSquads/{squadId} {
      allow read, write: if true;
    }

    // Community Posts - Public read and community interaction
    match /communityPosts/{postId} {
      allow read, write: if true;
    }

    // Community Post Likes
    match /postLikes/{likeId} {
      allow read, write: if true;
    }

    // Community Post Comments
    match /postComments/{commentId} {
      allow read, write: if true;
    }

    // Payment Records
    match /paymentRecords/{recordId} {
      allow read, write: if true;
    }
  }
}
